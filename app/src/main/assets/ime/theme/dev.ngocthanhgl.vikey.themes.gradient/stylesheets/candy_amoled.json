{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--bg": "rgba(0,0,0,1)",
    "--row0-bg": "rgba(220,80,160,1)",
    "--row0-fg": "rgba(255,230,245,1)",
    "--row1-bg": "rgba(190,70,140,1)",
    "--row1-fg": "rgba(250,225,240,1)",
    "--row2-bg": "rgba(155,55,115,1)",
    "--row2-fg": "rgba(245,215,230,1)",
    "--row3-bg": "rgba(110,40,80,1)",
    "--row3-fg": "rgba(235,200,220,1)",
    "--row4-bg": "rgba(70,25,50,1)",
    "--row4-fg": "rgba(220,180,205,1)",
    "--shift-bg": "rgba(25,8,20,1)",
    "--shift-fg": "rgba(235,200,225,1)",
    "--del-bg": "rgba(50,10,25,1)",
    "--del-fg": "rgba(220,60,100,1)",
    "--sp-bg": "rgba(200,100,160,1)",
    "--sp-fg": "rgba(20,8,15,1)",
    "--enter-bg": "rgba(25,10,20,1)",
    "--enter-fg": "rgba(200,100,160,1)",
    "--sym1-bg": "rgba(40,15,30,1)",
    "--sym1-fg": "rgba(235,200,225,1)",
    "--sym2-bg": "rgba(210,180,200,1)",
    "--sym2-fg": "rgba(210,180,200,0.28235295)",
    "--sym3-bg": "rgba(25,10,20,1)",
    "--sym3-fg": "rgba(235,200,225,1)",
    "--emoji-bg": "rgba(235,200,225,1)",
    "--t-emoji": "rgba(100,30,70,1)",
    "--comma-bg": "rgba(55,20,40,1)",
    "--comma-fg": "rgba(200,100,160,1)",
    "--dot-bg": "rgba(70,25,50,1)",
    "--dot-fg": "rgba(200,100,160,1)",
    "--acc": "rgba(255,100,200,1)",
    "--pressed": "rgba(200,120,170,1)",
    "--t-pressed": "rgba(20,8,15,1)",
    "--kpop": "rgba(80,30,60,1)",
    "--t-kpop": "rgba(235,200,225,1)",
    "--kpop-f": "rgba(100,40,75,1)",
    "--t-bg": "rgba(200,160,185,1)",
    "--t-bg-dim": "rgba(200,160,185,0.28235295)",
    "--fn1": "rgba(25,8,20,1)",
    "--t-fn1": "rgba(235,200,225,1)",
"--shape": "rounded-corner(25dp,25dp,25dp,25dp)",
    "--shape-pill": "rounded-corner(22dp,22dp,22dp,22dp)",
    "--shape-var": "rounded-corner(14dp,14dp,14dp,14dp)"
  },
"window": {
    "background": "var(--bg)",
    "foreground": "var(--t-bg)",
    "clip": "no"
  },
  "window[windowmode=`floating`]": {
    "shadow-elevation": "8dp",
    "shape": "rounded-corner(5%,5%,5%,5%)"
  },
  "window-move-handle[windowmode=`fixed`]": {
    "background": "var(--fn1)",
    "foreground": "var(--acc)",
    "font-size": "24sp",
    "margin": "16dp 0dp 16dp 0dp",
    "padding": "8dp 8dp 8dp 8dp",
    "shape": "circle()"
  },
  "window-resize-action[windowmode=`fixed`]": {
    "background": "var(--enter-bg)",
    "foreground": "var(--enter-fg)",
    "font-size": "24sp",
    "padding": "8dp 8dp 8dp 8dp",
    "shape": "circle()"
  },
  "window-resize-action[windowmode=`floating`]": {
    "background": "var(--fn1)",
    "foreground": "var(--enter-bg)",
    "shape": "circle()"
  },
  "window-resize-handle": {
    "background": "var(--enter-bg)"
  },
  "floating-dock-to-fixed-indicator": {
    "background": "var(--enter-bg)"
  },
  "key": {
    "background": "var(--row0-bg)",
    "foreground": "var(--row0-fg)",
    "font-size": "22sp",
    "shape": "var(--shape)",
    "text-max-lines": "1"
  },
  "key[row=1]": {
    "background": "var(--row1-bg)",
    "foreground": "var(--row1-fg)"
  },
  "key[row=2]": {
    "background": "var(--row2-bg)",
    "foreground": "var(--row2-fg)"
  },
  "key[row=3]": {
    "background": "var(--row3-bg)",
    "foreground": "var(--row3-fg)"
  },
  "key[row=4]": {
    "background": "var(--row4-bg)",
    "foreground": "var(--row4-fg)"
  },
  "key[code=-11]": {
    "background": "var(--shift-bg)",
    "foreground": "var(--shift-fg)"
  },
  "key[code=-201]": {
    "background": "var(--del-bg)",
    "foreground": "var(--del-fg)",
    "font-size": "18sp"
  },
  "key[code=-202,-203]": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "font-size": "18sp"
  },
  "key[code=-204]": {
    "background": "var(--emoji-bg)",
    "foreground": "var(--t-emoji)",
    "shape": "var(--shape-pill)"
  },
  "key[code=-205]": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "font-size": "12sp",
    "text-max-lines": "2",
    "shape": "var(--shape-pill)"
  },
  "key[code=10]": {
    "background": "var(--enter-bg)",
    "foreground": "var(--enter-fg)",
    "shape": "var(--shape-pill)"
  },
  "key[code=32]": {
    "background": "var(--sp-bg)",
    "foreground": "var(--sp-fg)",
    "font-size": "12sp",
    "text-overflow": "ellipsis",
    "shape": "var(--shape-pill)"
  },
  "key[code=44]": {
    "background": "var(--comma-bg)",
    "foreground": "var(--comma-fg)"
  },
  "key[code=46]": {
    "background": "var(--dot-bg)",
    "foreground": "var(--dot-fg)"
  },
  "key[code=123,125,40,41,60,62,91,93]": {
    "background": "var(--sym1-bg)",
    "foreground": "var(--sym1-fg)"
  },
  "key[code=37,38,42,43,45,47,61,94]": {
    "background": "var(--sym2-bg)",
    "foreground": "var(--sym2-fg)"
  },
  "key[code=124,126,33..36,39,58,59,63,64,92,95,96]": {
    "background": "var(--sym3-bg)",
    "foreground": "var(--sym3-fg)"
  },
  "key[code=-11][shiftstate=`caps_lock`]": {
    "foreground": "var(--acc)"
  },
  "key:pressed": {
    "background": "var(--pressed)",
    "foreground": "var(--t-pressed)"
  },
  "key[code=-11]:pressed": {
    "background": "var(--pressed)",
    "foreground": "var(--acc)"
  },
  "key[code=-201]:pressed": {
    "background": "var(--pressed)",
    "foreground": "var(--acc)"
  },
  "key[code=10]:pressed": {
    "background": "var(--pressed)",
    "foreground": "var(--acc)",
    "shape": "var(--shape-pill)"
  },
  "key[code=32]:pressed": {
    "background": "var(--pressed)",
    "foreground": "var(--t-pressed)",
    "shape": "var(--shape-pill)"
  },
  "key-hint": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--acc)",
    "font-family": "monospace",
    "font-size": "11sp",
    "padding": "0dp 1dp 2dp 0dp",
    "text-max-lines": "1"
  },
  "key-popup-box": {
    "background": "var(--kpop)",
    "foreground": "var(--t-kpop)",
    "font-size": "22sp",
    "shape": "var(--shape)",
    "shadow-elevation": "2dp"
  },
  "key-popup-element[code=-255]": {
    "font-size": "18sp",
    "text-max-lines": "1"
  },
  "key-popup-element:focus": {
    "background": "var(--kpop-f)",
    "shape": "var(--shape)"
  },
  "key-popup-extended-indicator": {
    "font-size": "16sp"
  },
  "clipboard-header": {
    "foreground": "var(--t-bg)",
    "font-size": "16sp"
  },
  "clipboard-header-button": {
    "margin": "4dp 4dp 4dp 4dp",
    "shape": "circle()"
  },
  "clipboard-header-button:disabled": {
    "foreground": "var(--t-bg-dim)"
  },
  "clipboard-header-text": {
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "clipboard-subheader": {
    "font-size": "14sp",
    "margin": "6dp 6dp 6dp 6dp"
  },
  "clipboard-content": {
    "padding": "10dp 10dp 10dp 10dp"
  },
  "clipboard-item": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "font-size": "14sp",
    "margin": "4dp 4dp 4dp 4dp",
    "padding": "12dp 8dp 12dp 8dp",
    "shape": "var(--shape-var)",
    "shadow-elevation": "2dp"
  },
  "clipboard-item-popup": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "margin": "4dp 4dp 4dp 4dp",
    "shape": "var(--shape-var)",
    "shadow-elevation": "2dp"
  },
  "clipboard-clear-all-dialog": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "shape": "var(--shape-var)",
    "shadow-elevation": "1dp"
  },
  "clipboard-clear-all-dialog-message": {
    "padding": "16dp 16dp 16dp 16dp"
  },
  "clipboard-clear-all-dialog-buttons": {
    "padding": "4dp 4dp 4dp 4dp"
  },
  "clipboard-clear-all-dialog-button": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-fn1)",
    "shape": "var(--shape-var)"
  },
  "clipboard-history-disabled-title": {
    "font-weight": "bold"
  },
  "clipboard-history-disabled-message": {
    "padding": "0dp 4dp 0dp 8dp"
  },
  "clipboard-history-disabled-button": {
    "background": "var(--enter-bg)",
    "foreground": "var(--enter-fg)",
    "shape": "var(--shape-pill)"
  },
  "clipboard-history-locked-title": {
    "font-weight": "bold",
    "text-align": "center"
  },
  "clipboard-history-locked-message": {
    "padding": "0dp 4dp 0dp 0dp",
    "text-align": "center"
  },
  "extracted-landscape-input-layout": {
    "background": "var(--bg)"
  },
  "extracted-landscape-input-field": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-bg)",
    "font-size": "16sp",
    "shape": "var(--shape-pill)",
    "border-color": "var(--acc)",
    "border-width": "2dp"
  },
  "extracted-landscape-input-action": {
    "background": "var(--enter-bg)",
    "foreground": "var(--enter-fg)",
    "shape": "var(--shape-pill)"
  },
  "glide-trail": {
    "foreground": "var(--acc)"
  },
  "incognito-mode-indicator": {
    "foreground": "var(--fn1)"
  },
  "media-emoji-subheader": {
    "font-weight": "bold",
    "margin": "4dp 4dp 4dp 4dp"
  },
  "media-emoji-key": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-bg)",
    "font-size": "22sp",
    "shape": "var(--shape)"
  },
  "media-emoji-key:pressed": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)"
  },
  "media-emoji-key-popup-box": {
    "background": "var(--kpop)",
    "foreground": "var(--t-kpop)",
    "font-size": "22sp",
    "shape": "var(--shape)",
    "shadow-elevation": "2dp"
  },
  "media-emoji-key-popup-element:focus": {
    "background": "var(--kpop-f)",
    "shape": "var(--shape)"
  },
  "media-emoji-key-popup-extended-indicator": {
    "foreground": "inherit"
  },
  "media-bottom-row-button": {
    "padding": "16dp 0dp 16dp 0dp",
    "shape": "var(--shape)"
  },
  "one-handed-panel": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)"
  },
  "smartbar": {
    "font-size": "18sp"
  },
  "smartbar-shared-actions-toggle": {
    "background": "var(--fn1)",
    "foreground": "var(--acc)",
    "margin": "6dp 6dp 6dp 6dp",
    "shape": "circle()",
    "shadow-elevation": "2dp"
  },
  "smartbar-extended-actions-toggle": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-bg)",
    "shape": "circle()"
  },
  "smartbar-action-key": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-bg)",
    "margin": "2dp 2dp 2dp 2dp",
    "shape": "var(--shape)"
  },
  "smartbar-action-key:disabled": {
    "foreground": "var(--t-bg-dim)"
  },
  "smartbar-action-tile": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-bg)",
    "font-size": "14sp",
    "margin": "4dp 0dp 4dp 0dp",
    "shape": "var(--shape)",
    "text-max-lines": "2",
    "text-align": "center",
    "text-overflow": "ellipsis"
  },
  "smartbar-action-tile:disabled": {
    "foreground": "var(--t-bg-dim)"
  },
  "smartbar-action-tile-icon": {
    "font-size": "18sp"
  },
  "smartbar-actions-overflow-customize-button": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "font-size": "14sp",
    "shape": "circle()"
  },
  "smartbar-actions-editor": {
    "background": "var(--bg)",
    "foreground": "var(--t-bg)",
    "shape": "rounded-corner(24dp,24dp,0dp,0dp)"
  },
  "smartbar-actions-editor-header": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "font-size": "16sp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-header-button": {
    "margin": "4dp 4dp 4dp 4dp",
    "shape": "circle()"
  },
  "smartbar-actions-editor-subheader": {
    "foreground": "var(--t-bg)",
    "font-size": "16sp"
  },
  "smartbar-actions-editor-tile-grid": {
    "margin": "8dp 8dp 10dp 8dp"
  },
  "smartbar-actions-editor-tile": {
    "font-size": "14sp",
    "margin": "0dp 4dp 4dp 4dp",
    "padding": "2dp 2dp 2dp 2dp",
    "text-align": "center",
    "text-max-lines": "2",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-tile[code=-991]": {
    "foreground": "var(--acc)"
  },
  "smartbar-actions-editor-tile[code=-999]": {
    "foreground": "var(--t-bg-dim)"
  },
  "smartbar-candidate-word": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--acc)",
    "font-size": "15sp",
    "font-weight": "normal",
    "padding": "10dp 4dp 10dp 4dp",
    "shape": "rectangle()",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-candidate-word:pressed": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)"
  },
  "smartbar-candidate-clip": {
    "background": "rgba(0,0,0,0)",
    "foreground": "var(--t-bg)",
    "font-size": "14sp",
    "margin": "4dp 4dp 4dp 2dp",
    "padding": "10dp 0dp 10dp 0dp",
    "shape": "rectangle()"
  },
  "smartbar-candidate-clip:pressed": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)"
  },
  "smartbar-candidate-clip-icon": {
    "font-size": "18sp",
    "margin": "0dp 0dp 8dp 0dp"
  },
  "smartbar-candidate-spacer": {
    "foreground": "var(--acc)"
  },
  "subtype-panel": {
    "background": "var(--bg)",
    "foreground": "var(--t-bg)",
    "shape": "rounded-corner(24dp,24dp,0dp,0dp)"
  },
  "subtype-panel-header": {
    "background": "var(--fn1)",
    "foreground": "var(--t-fn1)",
    "font-size": "18sp",
    "padding": "12dp 12dp 12dp 12dp",
    "text-align": "center",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "clipboard-item-popup-action": {
    "font-size": "16sp",
    "padding": "12dp 12dp 12dp 12dp"
  }

}